// The primary architecture map: components, dependency direction, and the
// two network families. Edges read "depends on" unless labeled. Checked
// against cargo metadata by scripts/check-architecture-map.py; the committed
// SVG is generated by the same script. Node ids that name crates must match
// workspace member names exactly.
digraph powerio_architecture {
    rankdir = BT;
    bgcolor = "transparent";
    node [shape = box, style = "rounded,filled", fillcolor = "#f4f6f8",
          color = "#4a5568", fontname = "Helvetica", fontsize = 11,
          fontcolor = "#1a202c"];
    edge [color = "#4a5568", fontname = "Helvetica", fontsize = 9,
          fontcolor = "#2d3748"];

    subgraph cluster_consumers {
        label = "representative consumers";
        fontname = "Helvetica"; fontsize = 10; color = "#a0aec0"; fontcolor = "#4a5568";
        solvers [label = "solvers\n(Tellegen, ExaModelsPower,\nBMOPFTools)", fillcolor = "#ffffff"];
        gridfm_ml [label = "GridFM pipeline", fillcolor = "#ffffff"];
    }

    "powerio-cli" [label = "powerio-cli\nCLI + TUI"];
    "powerio-capi" [label = "powerio-capi\nC ABI 6 (Julia, C, C++)"];
    "powerio-py" [label = "powerio-py\nPython package + MCP"];

    powerio [label = "powerio (facade)\nparse, PioValue, .pio.json,\nwrite dispatch"];

    "powerio-matrix" [label = "powerio-matrix\nsparse matrices, graph data"];
    "powerio-prob" [label = "powerio-prob\noperating points, 7 instances,\n7 solutions"];

    "powerio-tx" [label = "powerio-tx\nBalancedNetwork\n+ balanced formats"];
    "powerio-dist" [label = "powerio-dist\nMulticonductorNetwork\n+ OpenDSS, PMD, BMOPF"];

    "powerio-core" [label = "powerio-core\nSource, Diagnostic, Error,\nPioModule<T>, series, output"];

    "powerio-tx" -> "powerio-core";
    "powerio-dist" -> "powerio-core";
    "powerio-prob" -> "powerio-core";
    "powerio-prob" -> "powerio-tx";
    "powerio-prob" -> "powerio-dist";
    "powerio-matrix" -> "powerio-core";
    "powerio-matrix" -> "powerio-tx";
    "powerio-matrix" -> "powerio-dist";
    "powerio-matrix" -> "powerio-prob";
    powerio -> "powerio-core";
    powerio -> "powerio-tx";
    powerio -> "powerio-dist";
    powerio -> "powerio-prob";
    powerio -> "powerio-matrix" [label = "matrix feature", style = dashed];
    "powerio-cli" -> powerio;
    "powerio-capi" -> powerio;
    "powerio-py" -> powerio;

    solvers -> "powerio-prob" [label = "consume instances", style = dashed];
    gridfm_ml -> "powerio-matrix" [label = "Parquet datasets", style = dashed];
}
