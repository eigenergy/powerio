// The parse-to-emit data flow: acquisition, parse, the typed module, explicit
// transformations, calculations, emission, and PowerIO IR. Nodes are operations and data,
// not crates, so the checker validates only its syntax and generation.
digraph powerio_dataflow {
    rankdir = LR;
    bgcolor = "#f4f6f8";
    node [shape = box, style = "rounded,filled", fillcolor = "#f4f6f8",
          color = "#4a5568", fontname = "Helvetica", fontsize = 11,
          fontcolor = "#1a202c"];
    edge [color = "#4a5568", fontname = "Helvetica", fontsize = 9,
          fontcolor = "#2d3748"];

    source [label = "Source\nnamed immutable bytes\n(file, directory, memory)"];
    parse [label = "parse\ngrid exchange format\n+ structural type detection"];
    module [label = "PioModule<T>\nvalue + source + diagnostics\n+ history"];
    access [label = "index / iterate\nTimeSeries<T>, ScenarioSet<T>\nowner rooted typed entry"];
    transform [label = "to_balanced\nmulticonductor → balanced\n(explicit, lossy, reported)"];
    matrices [label = "calc_*\nmatrix or vector\nwith element mappings"];
    emit [label = "emit\nsame format: byte exact\ncross format: reported losses"];
    stored [label = "PowerIO IR\npowerio.module, version 1"];

    source -> parse -> module;
    module -> access [label = "collection value"];
    module -> transform [label = "multiconductor"];
    transform -> module [style = dashed, label = "derived module"];
    module -> matrices;
    module -> emit;
    module -> stored [label = "serialize"];
    stored -> module [label = "deserialize"];
}
