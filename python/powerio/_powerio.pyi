"""Type stubs for the compiled ``powerio._powerio`` extension (PyO3).

Hand-written to match powerio-py/src/lib.rs. Keep in sync when the Rust ABI
changes; this is what makes the ``py.typed`` package statically checkable. The
matrix methods return COO triplets as plain Python lists; the pure-Python
``powerio.BalancedNetwork`` wrapper turns them into scipy/networkx objects.
"""

from typing import Any, Dict, List, Literal, Optional, Tuple

__version__: str
_has_gridfm: bool
__all__ = [
    "Diagnostic",
    "PowerIODataError",
    "PowerIOError",
    "PowerIOParseError",
    "SourceSpan",
    "_BalancedNetwork",
    "_MulticonductorNetwork",
    "_PioModule",
    "__version__",
    "_has_gridfm",
    "classify_json_text",
    "from_json",
    "json_classes",
    "parse_display_file",
    "parse_geo",
    "versions_json",
]

class PowerIOError(ValueError):
    """Base error from the powerio parser, emitter, or matrix calculations.

    Failures mapped from the Rust core carry the diagnostic code string as
    ``code``; it is set at raise time, so it is instance-only.
    """

    code: str

class PowerIOParseError(PowerIOError):
    """A case file is malformed or unparseable."""

class PowerIODataError(PowerIOError):
    """A well-formed case cannot satisfy a requested operation.

    A refused pass (e.g. ``_PioModule.lower_to_balanced``) additionally sets
    ``diagnostics``: the pass's structured findings, each a dict with
    ``code``, ``severity``, ``message``, and ``target``. Absent on a
    ``PowerIODataError`` raised elsewhere.
    """

    diagnostics: List[Dict[str, Any]]

