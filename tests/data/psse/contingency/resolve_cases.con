COM resolve_cases: one case per binding rule the resolver states.
CONTINGENCY 'BR_1_2_C1'
OPEN LINE FROM BUS      1 TO BUS      2 CIRCUIT 1
END
CONTINGENCY 'BR_1_2_C2'
OPEN LINE FROM BUS      1 TO BUS      2 CIRCUIT 2
END
CONTINGENCY 'BR_REVERSED'
OPEN LINE FROM BUS      1 TO BUS      3 CIRCUIT 1
END
CONTINGENCY 'BR_NAMED_CIRCUIT'
OPEN LINE FROM BUS      4 TO BUS      5 CIRCUIT BL
END
CONTINGENCY 'BR_OUT_OF_SERVICE'
OPEN LINE FROM BUS      2 TO BUS      3 CIRCUIT 1
END
CONTINGENCY 'BR_MISSING'
OPEN LINE FROM BUS      3 TO BUS      4 CIRCUIT 1
END
CONTINGENCY 'MACHINE_B1_1'
REMOVE MACHINE 1 FROM BUS      1
END
CONTINGENCY 'MACHINE_B1_2'
ADD MACHINE 2 TO BUS      1
END
CONTINGENCY 'MACHINE_B2_3'
REMOVE MACHINE 3 FROM BUS      2
END
CONTINGENCY 'MACHINE_B2_1'
REMOVE MACHINE 1 FROM BUS      2
END
CONTINGENCY 'MACHINE_MISSING'
REMOVE MACHINE 9 FROM BUS      1
END
CONTINGENCY 'SHUNTS_AT_BUS'
REMOVE SHUNT FROM BUS      3
END
CONTINGENCY 'SHUNT_BY_ID'
REMOVE SHUNT 2 FROM BUS      3
END
CONTINGENCY 'SWITCHED_SHUNT'
REMOVE SWSHUNT FROM BUS      3
END
CONTINGENCY 'LOADS_AT_BUS'
REMOVE LOAD FROM BUS      4
END
CONTINGENCY 'THREE_WINDING'
OPEN THREEWINDING AT BUS      5 TO BUS      2 TO BUS      4 CIRCUIT 1
END
CONTINGENCY 'BUS_DISCONNECT'
DISCONNECT BUS      5
END
CONTINGENCY 'LOAD_CHANGE'
INCREASE BUS      4 LOAD BY 10 PERCENT
END
CONTINGENCY 'NO_ACTIONS'
END
CONTINGENCY 'UNRECOGNIZED'
PARALLEL BRANCH FROM BUS      1 TO BUS      2
END
END
