COM selectors: every selector spelling the reader states.
SUBSYSTEM 'A1'
   AREA 1
END

SUBSYSTEM 'AREARANGE'
   AREAS 1 2
END
SUBSYSTEM BARE
	ZONE 3
	OWNER 3
END
SUBSYSTEM 'BUSLIST'
   BUS 101
   BUS 203
END
SUBSYSTEM 'BUSRANGE'
   BUSES 101 103
END
SUBSYSTEM 'KV'
   KVRANGE 100.0 240.0
END
SYSTEM 'JOINED'
   JOIN 'HIGH'
      AREA 1
      KVRANGE 200.0 240.0
   END
   JOIN 'LOW'
      BUS 203
   END
END
SUBSYSTEM 'BAREJOIN'
   JOIN
      AREA 1
      KVRANGE 200.0 240.0
   END
   JOIN
      BUS 203
   END
END
SUBSYSTEM ONELINE AREA 1 ZONE 2 END
SUBSYSTEM 'A2'
   AREA 2
   SCALE ALL FOR EXPORT INCLUDE OFFLINE
END
